{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "tesouraco-flavio-bolsonaro.vercel.app"
        }
      ],
      "destination": "https://simulador-orcamento-federal.vercel.app/$1",
      "permanent": true
    }
  ]
}
